  ward =3D ward.replace(/^p\.(?=3D\S)/i, "Ph=C6=B0=E1=BB=9Dng ");
  ward =3D ward.replace(/^p\s+(?=3D\S)/i, "Ph=C6=B0=E1=BB=9Dng ");
  ward =3D ward.replace(/^x\.(?=3D\S)/i, "X=C3=A3 ");
  ward =3D ward.replace(/^x\s+(?=3D\S)/i, "X=C3=A3 ");
  ward =3D ward.replace(/^tt\.(?=3D\S)/i, "Th=E1=BB=8B tr=E1=BA=A5n ");
  ward =3D ward.replace(/^tt\s+(?=3D\S)/i, "Th=E1=BB=8B tr=E1=BA=A5n ");

  return ward.replace(/\s+/g, " ").trim();
}

