# Sao chép thành BE/.env rồi điền giá trị. KHÔNG commit file .env.

# Bắt buộc cho /api/ocr-cccd (lấy tại https://console.groq.com/keys)
GROQ_API_KEY=

# Model vision của Groq, phải hỗ trợ response_format json_schema
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Origin của FE được phép gọi API, phân tách bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Mặc định chỉ nghe localhost, tắt debug. Chỉ bật debug khi dev trên máy cá nhân.
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=0
