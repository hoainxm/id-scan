# Sao chép thành BE/.env rồi điền giá trị. KHÔNG commit file .env.

# ---- Đọc thông tin CCCD (cần ít nhất 1 API key) ----
# Thứ tự thử nhà cung cấp; lỗi/hết hạn mức thì tự chuyển sang nhà cung cấp kế tiếp.
OCR_PROVIDERS=openai,groq

# OpenAI (nhà cung cấp chính): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
# high: đọc rõ chữ có dấu; low: rẻ hơn nhiều nhưng dễ sai chữ nhỏ
OPENAI_IMAGE_DETAIL=high

# Groq (dự phòng, có gói miễn phí): https://console.groq.com/keys
GROQ_API_KEY=
# Model phải hỗ trợ response_format json_schema
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Origin của FE được phép gọi API, phân tách bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Mặc định chỉ nghe localhost, tắt debug. Chỉ bật debug khi dev trên máy cá nhân.
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=0
